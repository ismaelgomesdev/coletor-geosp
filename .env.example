# Copie para .env e ajuste. O .env não vai para o git.

# PostgreSQL/PostGIS, como o coletor enxerga o banco
PG_HOST=localhost
PG_PORT=5432
PG_DB=geosp
PG_USER=coletor
PG_PASSWORD=troque-esta-senha

# GeoServer instalado na máquina do laboratório
GEOSERVER_URL=http://localhost:8080/geoserver
GEOSERVER_USER=admin
GEOSERVER_PASSWORD=troque-esta-senha

# Como o GeoServer enxerga o banco (se for diferente do acima).
# O ideal é um usuário só de leitura.
GEOSERVER_PG_HOST=localhost
GEOSERVER_PG_PORT=5432
GEOSERVER_PG_USER=geoserver_ro
GEOSERVER_PG_PASSWORD=troque-esta-senha

# Pastas de trabalho
DIR_DADOS=dados
DIR_LOGS=logs
DIR_CATALOGO=catalogo
